---
import { about } from "../content/about";

const { origin } = about;
---

<section id="origin" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 sm:py-24">
  <header class="max-w-3xl">
    <p
      class="text-xs font-semibold tracking-[0.16em] text-accent-600 uppercase"
    >
      {origin.eyebrow}
    </p>
    <h2
      class="mt-3 text-3xl leading-tight font-semibold tracking-tight text-navy-950 sm:text-4xl"
    >
      {origin.heading}
    </h2>
  </header>

  <div
    data-testid="origin-paragraphs"
    class="mt-8 grid max-w-3xl gap-6 text-base leading-relaxed text-ink"
  >
    {origin.paragraphs.map((p) => <p>{p}</p>)}
  </div>
</section>
