---
import { about } from "../content/about";
---

<section
  data-testid="about-hero"
  class="relative isolate overflow-hidden border-b border-rule"
>
  <div class="mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24 sm:pb-24">
    <p
      class="text-xs font-semibold tracking-[0.16em] text-accent-600 uppercase"
    >
      {about.eyebrow}
    </p>
    <h1
      class="mt-5 max-w-3xl text-4xl leading-[1.05] font-semibold tracking-tight text-navy-950 sm:text-5xl md:text-6xl md:leading-[1.1]"
    >
      {about.heading}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl">
      {about.intro}
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-faint">
      {about.lede}
    </p>
  </div>
</section>
