---
interface Props {
  heading: string;
  body: string;
  href: string;
  linkLabel: string;
  testid: string;
}

const { heading, body, href, linkLabel, testid } = Astro.props;
---

<div data-testid={testid} class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
  <div class="max-w-3xl">
    <h2
      class="text-3xl leading-tight font-semibold tracking-tight text-navy-950 sm:text-4xl"
    >
      {heading}
    </h2>
    <p class="mt-6 text-lg leading-relaxed text-ink-muted">
      {body}
    </p>
    <a
      href={href}
      data-testid={`${testid}-link`}
      class="mt-8 inline-flex items-center text-base font-medium text-accent-600 hover:text-accent-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
    >
      {linkLabel}
    </a>
  </div>
</div>
