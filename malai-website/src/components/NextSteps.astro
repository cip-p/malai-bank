---
import { nextSteps } from "../content/next-steps";

const primaryClass =
  "inline-flex items-center rounded-md bg-navy-950 px-5 py-3 text-base font-medium text-warm-white transition-colors hover:bg-navy-800 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500";
const secondaryClass =
  "inline-flex items-center rounded-md border border-rule bg-warm-white px-5 py-3 text-base font-medium text-navy-950 transition-colors hover:border-navy-700 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500";
---

<section
  id="next-steps"
  data-testid="next-steps"
  aria-labelledby="next-steps-heading"
  class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 sm:py-24"
>
  <div class="rounded-xl border border-rule bg-warm-paper p-8 sm:p-10">
    <div class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.16em] text-accent-600 uppercase"
      >
        {nextSteps.eyebrow}
      </p>
      <h2
        id="next-steps-heading"
        class="mt-3 text-2xl font-semibold tracking-tight text-balance text-navy-950 sm:text-3xl"
      >
        {nextSteps.heading}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-pretty text-ink-muted">
        {nextSteps.intro}
      </p>
    </div>

    <ol
      class="mt-10 grid grid-cols-1 divide-y divide-rule md:grid-cols-2 md:divide-x md:divide-y-0"
    >
      {
        nextSteps.steps.map((step, index) => (
          <li
            data-testid="next-step"
            class:list={[
              "flex flex-col py-8 first:pt-0 last:pb-0 md:py-0 md:first:pr-10 md:last:pl-10",
            ]}
          >
            <span class="text-xs font-medium tracking-wide text-ink-faint uppercase">
              Step {index + 1}
            </span>
            <h3 class="mt-2 text-lg font-semibold tracking-tight text-navy-950">
              {step.title}
            </h3>
            <p class="mt-3 grow text-sm leading-relaxed text-ink-muted">
              {step.body}
            </p>
            <div class="mt-6">
              <a
                href={step.cta.href}
                target={step.external ? "_blank" : undefined}
                aria-describedby={step.external ? "new-tab-hint" : undefined}
                rel={step.external ? "noopener noreferrer" : undefined}
                class={index === 0 ? primaryClass : secondaryClass}
              >
                {step.cta.label}
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
