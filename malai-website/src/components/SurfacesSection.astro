---
import type { ImageMetadata } from "astro";
import { surfaces } from "../content/surfaces";
import Screenshot from "./Screenshot.astro";

const { heading, narrative, cards } = surfaces;

const screenshotModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/*.png",
  { eager: true },
);

const screenshotSrc = (file: string): ImageMetadata => {
  const module = screenshotModules[`../assets/screenshots/${file}`];
  if (!module) throw new Error(`Missing screenshot asset: ${file}`);
  return module.default;
};
---

<div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
  <header class="max-w-3xl">
    <h2
      class="text-3xl leading-tight font-semibold tracking-tight text-navy-950 sm:text-4xl"
    >
      {heading}
    </h2>
    <p class="mt-6 text-lg leading-relaxed text-ink-muted">
      {narrative}
    </p>
  </header>

  <ul
    data-testid="surface-grid"
    class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3"
  >
    {
      cards.map((card) => (
        <li
          data-testid="surface-card"
          class="flex flex-col rounded-lg border border-rule bg-warm-white p-6 transition-colors hover:border-navy-700"
        >
          <Screenshot
            src={screenshotSrc(card.screenshot.file)}
            alt={card.screenshot.alt}
            sizes="(min-width: 1024px) 30vw, calc(100vw - 5rem)"
            widths={[320, 640, 960, 1280]}
          />
          <span class="mt-5 text-xs font-medium tracking-wide text-ink-faint uppercase">
            {card.audience}
          </span>
          <h3 class="mt-1 text-base font-semibold tracking-tight text-navy-950">
            {card.name}
          </h3>
          <p class="mt-3 grow text-sm leading-relaxed text-ink-muted">
            {card.claim}
          </p>
          <a
            href={card.href}
            data-testid="surface-card-link"
            class="mt-4 inline-flex items-center text-sm font-medium text-accent-600 hover:text-accent-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
          >
            {card.linkLabel}
          </a>
        </li>
      ))
    }
  </ul>
</div>
