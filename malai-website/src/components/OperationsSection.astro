---
import type { ImageMetadata } from "astro";
import { operations } from "../content/operations";
import Screenshot from "./Screenshot.astro";

const {
  heading,
  narrative,
  stats,
  walkthroughHeading,
  steps,
  copilot,
  aml,
  seam,
  cta,
  evidence,
} = operations;

const screenshotModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/*.png",
  { eager: true },
);

const screenshotSrc = (file: string): ImageMetadata => {
  const module = screenshotModules[`../assets/screenshots/${file}`];
  if (!module) throw new Error(`Missing screenshot asset: ${file}`);
  return module.default;
};
---

<div class="bg-warm-white">
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-12 sm:pt-28">
    <header class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.16em] text-accent-600 uppercase"
      >
        Operations
      </p>
      <h1
        class="mt-3 text-3xl leading-tight font-semibold tracking-tight text-navy-950 sm:text-4xl"
      >
        {heading}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-muted">
        {narrative}
      </p>
    </header>

    <dl
      data-testid="operations-stats"
      class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-rule bg-rule sm:grid-cols-4"
    >
      {
        stats.map((stat) => (
          <div
            data-testid="operations-stat"
            class="flex flex-col gap-1 bg-warm-white px-5 py-6"
          >
            <dt class="text-xs leading-snug font-medium tracking-wide text-ink-muted uppercase">
              {stat.label}
            </dt>
            <dd class="font-mono text-lg leading-tight font-semibold text-navy-950 sm:text-xl">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-12">
    <h2 class="text-xl font-semibold tracking-tight text-navy-950">
      {walkthroughHeading}
    </h2>
    <ol data-testid="operations-steps" class="mt-8 flex flex-col gap-14">
      {
        steps.map((step, index) => (
          <li
            data-testid="operations-step"
            class="grid grid-cols-1 items-center gap-6 lg:grid-cols-2 lg:gap-12"
          >
            <div class:list={[index % 2 === 1 && "lg:order-2"]}>
              <span class="text-xs font-medium tracking-wide text-ink-faint uppercase">
                Step {index + 1}
              </span>
              <h3 class="mt-1 text-lg font-semibold tracking-tight text-navy-950">
                {step.title}
              </h3>
              <p class="mt-3 text-base leading-relaxed text-ink-muted">
                {step.text}
              </p>
            </div>
            <Screenshot
              src={screenshotSrc(step.screenshot.file)}
              alt={step.screenshot.alt}
              class:list={[index % 2 === 1 && "lg:order-1"]}
            />
          </li>
        ))
      }
    </ol>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <div
      data-testid="operations-copilot"
      class="grid grid-cols-1 items-center gap-6 rounded-lg border border-rule bg-warm-paper p-8 sm:p-10 lg:grid-cols-2 lg:gap-12"
    >
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-navy-950">
          {copilot.heading}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          {copilot.body}
        </p>
        <ul class="mt-6 flex flex-col gap-4">
          {
            copilot.points.map((point) => (
              <li
                data-testid="operations-copilot-point"
                class="flex gap-3 text-sm leading-relaxed text-ink"
              >
                <span
                  aria-hidden="true"
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-600"
                />
                {point}
              </li>
            ))
          }
        </ul>
      </div>
      <Screenshot
        src={screenshotSrc(copilot.screenshot.file)}
        alt={copilot.screenshot.alt}
      />
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <div data-testid="operations-aml">
      <h2 class="text-xl font-semibold tracking-tight text-navy-950">
        {aml.heading}
      </h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-muted">
        {aml.body}
      </p>
      <ol data-testid="operations-aml-steps" class="mt-10 flex flex-col gap-14">
        {
          aml.steps.map((step, index) => (
            <li
              data-testid="operations-aml-step"
              class="grid grid-cols-1 items-center gap-6 lg:grid-cols-2 lg:gap-12"
            >
              <div class:list={[index % 2 === 1 && "lg:order-2"]}>
                <span class="text-xs font-medium tracking-wide text-ink-faint uppercase">
                  Step {index + 1}
                </span>
                <h3 class="mt-1 text-lg font-semibold tracking-tight text-navy-950">
                  {step.title}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-ink-muted">
                  {step.text}
                </p>
              </div>
              <Screenshot
                src={screenshotSrc(step.screenshot.file)}
                alt={step.screenshot.alt}
                class:list={[index % 2 === 1 && "lg:order-1"]}
              />
            </li>
          ))
        }
      </ol>
      <ul class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-3">
        {
          aml.points.map((point) => (
            <li
              data-testid="operations-aml-point"
              class="rounded-lg border border-rule bg-warm-paper p-5 text-sm leading-relaxed text-ink"
            >
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <div
      data-testid="operations-seam"
      class="rounded-lg border border-rule bg-warm-white p-8 sm:p-10"
    >
      <h2 class="text-xl font-semibold tracking-tight text-navy-950">
        {seam.heading}
      </h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-muted">
        {seam.body}
      </p>
      <ul class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
        {
          seam.points.map((point) => (
            <li
              data-testid="operations-seam-point"
              class="rounded-lg border border-rule bg-warm-paper p-5 text-sm leading-relaxed text-ink"
            >
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 pt-4 pb-24 sm:pb-32">
    <a
      data-testid="operations-cta"
      href={cta.href}
      target="_blank"
      aria-describedby="new-tab-hint"
      rel="noopener noreferrer"
      class="inline-flex items-center rounded-md bg-navy-950 px-5 py-3 text-base font-medium text-warm-white transition-colors hover:bg-navy-800 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
    >
      {cta.label}
    </a>
    <p
      data-testid="operations-evidence"
      class="mt-6 text-sm leading-relaxed text-ink-muted"
    >
      {evidence.text}
      <a
        data-testid="operations-evidence-link"
        href={evidence.href}
        target="_blank"
        aria-describedby="new-tab-hint"
        rel="noopener noreferrer"
        class="font-medium whitespace-nowrap text-accent-600 hover:text-accent-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
      >
        {evidence.linkLabel}
      </a>
    </p>
  </div>
</div>
