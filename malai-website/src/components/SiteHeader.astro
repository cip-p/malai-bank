---
import { nav } from "../content/nav";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) =>
  href.startsWith("/") &&
  (pathname === href || (href !== "/" && pathname.startsWith(href)));
---

<header
  data-testid="site-header"
  class="sticky top-0 z-40 border-b border-rule bg-warm-white/85 backdrop-blur"
>
  <nav data-mode="sticky" aria-label="Primary" class="mx-auto w-full max-w-6xl">
    <div class="flex h-14 items-center justify-between gap-6 px-6">
      <a
        href="/"
        class="flex items-center gap-2 text-base font-semibold tracking-tight text-navy-950 hover:no-underline"
        aria-label="Malai — home"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 32 32"
          class="size-4 text-accent-600"
        >
          <path
            fill-rule="evenodd"
            fill="currentColor"
            d="M16 3.5 26.5 7.5V15c0 6.8-4.3 11.4-10.5 13.5C9.8 26.4 5.5 21.8 5.5 15V7.5Zm0 7a2.6 2.6 0 0 1 1.1 4.96L18.5 21h-5l1.4-5.54A2.6 2.6 0 0 1 16 10.5Z"
          ></path>
        </svg>
        <span class="text-lg">{nav.brand}</span>
      </a>

      <ul class="hidden items-center gap-x-6 lg:flex">
        {
          nav.anchors.map((anchor) => {
            const active = isActive(anchor.href);
            return (
              <li>
                <a
                  href={anchor.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "text-sm whitespace-nowrap transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500",
                    active
                      ? "font-medium text-navy-950"
                      : "text-ink-muted hover:text-navy-950",
                  ]}
                >
                  {anchor.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="flex items-center gap-3">
        <a
          href={nav.primaryCta.href}
          target="_blank"
          aria-describedby="new-tab-hint"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-md bg-navy-950 px-3.5 py-2 text-sm font-medium whitespace-nowrap text-warm-white transition-colors hover:bg-navy-800 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
        >
          {nav.primaryCta.label}
        </a>
        <button
          type="button"
          data-mobile-toggle
          aria-controls="mobile-nav-panel"
          aria-expanded="false"
          aria-label="Open menu"
          class="group -mx-1 inline-flex h-11 w-11 items-center justify-center focus-visible:outline-none lg:hidden"
        >
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-rule bg-warm-white text-navy-950 transition-colors group-hover:border-navy-700 group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-accent-500"
          >
            <svg
              data-icon-closed
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              class="size-5"
            >
              <path d="M3 6h14M3 10h14M3 14h14"></path>
            </svg>
            <svg
              data-icon-open
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              class="hidden size-5"
            >
              <path d="M5 5l10 10M15 5L5 15"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>

    <div
      id="mobile-nav-panel"
      data-mobile-panel
      hidden
      class="border-t border-rule bg-warm-paper shadow-sm lg:hidden"
    >
      <ul
        class="flex flex-col divide-y divide-rule"
        data-testid="mobile-nav-links"
      >
        {
          nav.anchors.map((anchor) => {
            const active = isActive(anchor.href);
            return (
              <li>
                <a
                  href={anchor.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "flex items-center justify-between px-6 py-4 text-base font-medium transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent-500",
                    active
                      ? "bg-navy-50 text-accent-600"
                      : "text-navy-950 hover:bg-navy-50 hover:text-accent-600",
                  ]}
                >
                  <span>{anchor.label}</span>
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 text-ink-faint"
                  >
                    <path d="M7 5l5 5-5 5" />
                  </svg>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-mobile-toggle]",
  );
  const panel = document.querySelector<HTMLElement>("[data-mobile-panel]");
  const iconClosed = toggle?.querySelector<HTMLElement>("[data-icon-closed]");
  const iconOpen = toggle?.querySelector<HTMLElement>("[data-icon-open]");

  if (toggle && panel && iconClosed && iconOpen) {
    const setOpen = (open: boolean) => {
      const focusWasInsidePanel = panel.contains(document.activeElement);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.toggleAttribute("hidden", !open);
      iconClosed.classList.toggle("hidden", open);
      iconOpen.classList.toggle("hidden", !open);
      if (!open && focusWasInsidePanel) toggle.focus();
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    panel.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("a")) setOpen(false);
    });
  }
</script>
