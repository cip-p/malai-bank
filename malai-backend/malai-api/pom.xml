        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-card-client-test-support</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test support from each bundled service (With* interfaces, CognitoTestData, etc.) -->
        <dependency>
            <groupId>malai</groupId>
            <artifactId>auth-service</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>account-service</artifactId>
            <version>${project.version}</version>
