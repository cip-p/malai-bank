        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!--
                    Kept solely so the inherited `repackage` execution produces the
                    `target/*-exec.jar` that the malai-api Dockerfile copies into the runtime
                    image. No `<executions>` block: the old pre-/post-integration-test boot
                    dance was a leftover from generating openapi.json from a running app — the
                    API Gateway definition lives in Terraform now and there are no actual
                    integration tests.
                -->
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
