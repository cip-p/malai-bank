<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>malai</groupId>
        <artifactId>malai-backend</artifactId>
        <version>DEV-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>bacs-gateway</artifactId>
    <name>BACS Gateway</name>
    <!--
        The bank's per-rail BACS connector. Bridges the external BACS scheme's HTTP world and
        malai's internal SQS world: exposes the inbound webhook the scheme calls when a BACS Direct
        Credit (e.g. salary) arrives, maps the scheme-shaped credit onto the canonical
        payments-bacs-event-received, and produces it back to payments-service. Inbound-only — BACS
        is BACS-DC inbound in v1, so there is no outbound submit path and no scheme HTTP client.
        Dumb and stateless — no decisions, no database. Bundled into malai-api in production; runs
        standalone (this module's Spring Boot app) in cross-stack e2e.
    -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-sqs</artifactId>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-payments-messages</artifactId>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-scheme-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-clients-common</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-acceptance-test-commons</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>malai</groupId>
            <artifactId>malai-test-commons</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.neovibrant</groupId>
            <artifactId>kacey</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
