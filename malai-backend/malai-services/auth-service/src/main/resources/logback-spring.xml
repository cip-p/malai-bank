<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <springProfile name="e2e-tests | dev | prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>timestamp</fieldName>
                        <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <version>
                        <fieldName>schema_version</fieldName>
                    </version>
                    <logLevel>
                        <fieldName>level</fieldName>
                    </logLevel>
                    <loggerName>
                        <fieldName>logger</fieldName>
                        <!-- Trim long FQNs to keep log lines manageable. -->
                        <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                    </loggerName>
                    <threadName>
                        <fieldName>thread</fieldName>
                    </threadName>
                    <message>
                        <fieldName>message</fieldName>
                    </message>
                    <!-- MDC = anything we put on the thread context (request id, etc). -->
                    <mdc/>
                    <!-- StructuredArguments.kv("foo", bar) -> top-level JSON keys. -->
                    <arguments/>
                    <stackTrace>
                        <fieldName>stack_trace</fieldName>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>30</maxDepthPerThrowable>
                            <maxLength>4096</maxLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <!-- Spring's default startup banner is plain text and breaks the JSON pipe;
             the rest of Spring's noise we keep at INFO. -->
        <logger name="org.springframework.boot.StartupInfoLogger" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!e2e-tests &amp; !dev &amp; !prod">
        <include resource="org/springframework/boot/logging/logback/base.xml"/>
    </springProfile>

</configuration>
